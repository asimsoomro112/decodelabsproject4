# --- SynapseBridge backend env (copy to backend/.env) ---
# Port the API listens on. Frontend dev server uses 5173 (scripts/serve-web.mjs).
PORT=4000

# Comma-separated CORS allowlist. The frontend origin MUST be listed here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Demo-only bearer tokens (labelled as such in the UI). Change in production.
DEMO_EDITOR_TOKEN=demo-editor
DEMO_ADMIN_TOKEN=demo-admin

# Rate limits (requests per minute). Lower values make the 429 demo easier.
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_WRITES_PER_MIN=20

# Optional: set to a Postgres connection string to use the pg adapter
# instead of the in-memory store. Leave unset for zero-setup default.
# DATABASE_URL=postgresql://user:password@localhost:5432/synapsebridge

NODE_ENV=development
